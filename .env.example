# Obligatoria salvo que LLM_MOCK=true. Nunca incluyas una clave real en este archivo.
OPENROUTER_API_KEY=

# Modelo usado por LiteLLM. Dots es gratuito, soporta Structured Outputs y usa
# actualmente un proveedor compatible de OpenRouter (no Cerebras directamente).
OPENROUTER_MODEL=openrouter/dots-studio/dots-3-note-preview:free

# Preferencia de proveedor; OpenRouter puede hacer fallback si no sirve el modelo.
OPENROUTER_PROVIDER_ORDER=cerebras

# Vacía = simulador integrado. Con una clave se usa Massive.
MASSIVE_API_KEY=

# Activa respuestas deterministas sin llamar a OpenRouter.
LLM_MOCK=false
